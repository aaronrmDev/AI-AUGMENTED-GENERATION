#!/usr/bin/env bash
# Pre-commit secret guard — see docs/security/SECRETS_MANAGEMENT.md
#
# Activate once per clone:  git config core.hooksPath .githooks
# Confirm it's active:      git config --get core.hooksPath   (should print ".githooks")
#
# This hook blocks a commit if it stages a file literally named .env, or if
# any staged addition matches a known API-key shape. It is defense-in-depth
# behind .gitignore, not a replacement for it.

set -euo pipefail

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
FOUND_PROBLEM=0

# --- 1. Block staging a file literally named .env (any path) ---
while IFS= read -r f; do
  [ -z "$f" ] && continue
  base=$(basename -- "$f")
  if [ "$base" = ".env" ]; then
    echo "BLOCKED: staged file '$f' is a .env file — real secrets belong in .env, which must never be committed." >&2
    FOUND_PROBLEM=1
  fi
done <<< "$STAGED_FILES"

# --- 2. Scan staged additions for known API-key shapes ---
# Anthropic keys: sk-ant-...
# Google / Gemini keys: AIza...
# Generic catch-all: a KEY/TOKEN/SECRET-looking variable assigned a long
# opaque value — covers providers (e.g. DeepSeek) whose exact key format
# isn't hardcoded here, on purpose, rather than asserting a prefix that
# hasn't been verified.
PATTERNS='sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|[A-Za-z_][A-Za-z0-9_]*(API_KEY|SECRET|TOKEN)[A-Za-z0-9_]*[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_-]{20,}'

DIFF_CONTENT=$(git diff --cached -U0 -- . ':(exclude).githooks/pre-commit' ':(exclude)docs/security/SECRETS_MANAGEMENT.md' ':(exclude).env.example' ':(exclude).env.template' 2>/dev/null || true)
ADDED_LINES=$(echo "$DIFF_CONTENT" | grep -E '^\+' | grep -vE '^\+\+\+' || true)

if echo "$ADDED_LINES" | grep -qE "$PATTERNS"; then
  echo "BLOCKED: a staged change looks like it contains a real API key or secret." >&2
  echo "Matching line(s):" >&2
  echo "$ADDED_LINES" | grep -E "$PATTERNS" | sed 's/^/  /' >&2
  echo "If this is a false positive (e.g. a placeholder like 'your_api_key_here'), adjust the pattern in .githooks/pre-commit rather than bypassing the hook." >&2
  FOUND_PROBLEM=1
fi

if [ "$FOUND_PROBLEM" -eq 1 ]; then
  echo "" >&2
  echo "Commit blocked by .githooks/pre-commit. See docs/security/SECRETS_MANAGEMENT.md." >&2
  exit 1
fi

exit 0
