# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. See docs/security/SECURITY.md point 1 and
# docs/evaluation/COMPARISON_METHODOLOGY.md for how these keys are used.

# --- API-based reference models (docs/evaluation/COMPARISON_METHODOLOGY.md) ---
# Anthropic Claude — primary qualitative judge, and a comparison reference point.
ANTHROPIC_API_KEY=

# Google Gemini — secondary qualitative judge / comparison reference point.
GEMINI_API_KEY=

# DeepSeek — coding-strength comparison reference point (not self-hosted).
DEEPSEEK_API_KEY=

# --- Self-hosted serving (docs/architecture/OVERVIEW.md, "Served models and hardware target") ---
# Local vLLM-on-ROCm endpoint serving Gemma 4 / Qwen3.8-27B.
VLLM_URL=http://localhost:8000
