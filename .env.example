# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. See docs/security/SECURITY.md point 1 and
# docs/evaluation/COMPARISON_METHODOLOGY.md for how these keys are used.

# --- API-based reference models (docs/evaluation/COMPARISON_METHODOLOGY.md) ---
# Anthropic Claude — primary qualitative judge, and a comparison reference point.
ANTHROPIC_API_KEY=

# Google Gemini — secondary qualitative judge / comparison reference point.
GEMINI_API_KEY=

# DeepSeek — coding-strength comparison reference point (not self-hosted).
DEEPSEEK_API_KEY=

# --- Self-hosted serving (docs/architecture/OVERVIEW.md, "Served models and hardware target") ---
# Local vLLM-on-ROCm endpoint serving Gemma 4 / Qwen3.8-27B.
# Port 8001, not 8000: docker/docker-compose.yml publishes the API itself on
# 8000, and these two are meant to run side by side.
VLLM_URL=http://localhost:8001

# --- Local infrastructure (docs/database/DATABASE.md, docs/architecture/MAG.md) ---
# The bootstrap/superuser connection. Used only by `alembic upgrade head`,
# which needs CREATE TABLE/EXTENSION and provisions the app_user role below.
# Nothing in the running application connects with this.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/unified_ai

# What the running application actually connects with — src/api/dependencies.py
# reads this at import time, so the app raises KeyError before it starts if it
# is missing. It is a *separate* URL from DATABASE_URL above, not a duplicate:
# PostgreSQL exempts both a superuser and a table's owner from row-level
# security no matter how correct the policy is, so an API running as the
# bootstrap role would make every RLS policy in this system silently inert.
# Hence the split — superuser migrates, non-owner app_user serves traffic.
# (Same reasoning, in more detail, in docker/docker-compose.yml's api service.)
APP_DATABASE_URL=postgresql+asyncpg://app_user:password@localhost:5432/unified_ai

# Password for the non-superuser `app_user` PostgreSQL role the identity
# migration provisions — distinct from whatever admin credentials
# DATABASE_URL itself carries, and the only role row-level security
# policies are actually enforced against. Must match the password embedded
# in APP_DATABASE_URL above.
APP_DB_PASSWORD=

# Redis connection for session cache and memory layer (MAG).
REDIS_URL=redis://localhost:6379/0

# JWT secret for signing and verifying authentication tokens (identity subsystem).
JWT_SECRET_KEY=

# Optional. Controls the Secure flag on the refresh-token cookie; defaults to
# true when unset, which is what any deployment should use. Set it to false
# ONLY for local development over plain HTTP, where a Secure cookie would
# never be sent back by the browser at all. Note the polarity: this is an
# opt-OUT, so forgetting to set it leaves the secure behavior in place.
# COOKIE_SECURE=false

# --- RAG Pipeline (docs/architecture/RAG.md) ---
# Model for generating answers from retrieved context in the chat endpoint.
# When CHAT_PROVIDER=ollama, this is an Ollama model tag (e.g. qwen3.5)
# instead of a Claude model id.
CHAT_MODEL=claude-opus-5

# Which ChatModel adapter src/api/dependencies.py wires up: "anthropic"
# (default, real cost, used for anything that must match the official
# ablation measurements) or "ollama" (local, zero marginal cost, for
# development-time proofs only -- docs/architecture/OVERVIEW.md's "When you
# might deviate from this stack" section; docs/evaluation/
# COMPARISON_METHODOLOGY.md's actual ablation subjects are vLLM-on-ROCm,
# unaffected by this switch).
# CHAT_PROVIDER=ollama

# Ollama's local HTTP endpoint. Only read when CHAT_PROVIDER=ollama.
# OLLAMA_HOST=http://localhost:11434
